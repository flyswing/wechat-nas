# WeChat Selkies
WECHAT_SELKIES_IMAGE=ghcr.io/nickrunning/wechat-selkies:0.0.12-minimal
# 大多数 Intel/AMD 群晖使用 linux/amd64；若你的设备是 ARM，请按实际架构调整。
WECHAT_SELKIES_PLATFORM=linux/amd64
PUID=1000
PGID=100
TZ=Asia/Shanghai
LC_ALL=zh_CN.UTF-8
SHM_SIZE=1gb
HTTP_BIND=0.0.0.0
HTTP_PORT=3000
HTTPS_BIND=0.0.0.0
HTTPS_PORT=3001
AUTO_START_WECHAT=true
AUTO_START_QQ=false
CUSTOM_USER=
# 必改：网页登录微信桌面时使用的密码。
PASSWORD=

# linux-wechat-agent
WECHAT_AGENT_IMAGE=docker.io/xiaoguiwucan/linux-wechat-agent:latest
MEMORY_SYNC_INTERVAL=5

# 当前登录微信的数据目录名称（不是 wxid 本身）。
WECHAT_ACCOUNT_DIR_NAME=

# NAS 文件归档目标路径。
NAS_ARCHIVE_DIR=
NAS_AGENT_INTERVAL=3
REPLY_WORKER_INTERVAL=3

# 允许自动回复的联系人 username；多个用英文逗号分隔。
ALLOWED_CHAT_USERNAMES=

# 群晖 Container Manager 不提供 Profile 选择界面；默认启动完整流程。
# 仅归档、不自动回复时改为：core,archive
COMPOSE_PROFILES=core,archive,reply
